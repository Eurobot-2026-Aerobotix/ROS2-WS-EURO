# Request - empty
---
# Response - list of active batch information

# Individual batch information
geometry_msgs/Point center
string known_id
string batch_type  # 'fx', 'sx', or 'gx'
int32 member_count
string direction  # 'horizontal', 'vertical', or empty
int32 quality  # Quality indicator (1 for now)

# Array of all active batches
geometry_msgs/Point[] centers
string[] known_ids
string[] batch_types
int32[] member_counts
string[] directions
int32[] qualities
