# Request
uint8 direction   # 1 = front of robot, 0 = back of robot
string color      # "yellow" or "blue"
bool use_pose     # true: use provided pose fields below; false: use TF/latest pose fallback
float64 x_mm      # robot x in mm (used when use_pose=true)
float64 y_mm      # robot y in mm (used when use_pose=true)
float64 theta_deg # robot heading in degrees (used when use_pose=true)
float64 insert_offset_mm # extra offset applied toward robot heading for dynamic put_down flows
---
# Response
bool success
string message
string[] obstacle_ids
